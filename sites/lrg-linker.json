    "hero",
    "quick-card",
    "callout",
    "bluf",
    "resources"
  ],
  "extra_zone_classes": [
    "rl-resources"
  ],
  "skip_slugs": [
    "privacy-policy",
    "home-old",
    "agents",
    "contact",
    "about-team-lrg",
    "home",
    "home-evaluation",
    "resources",
