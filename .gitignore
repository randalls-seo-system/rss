# Client configurations (sensitive)
sites/*.conf
sites/*.json
sites/*.env
sites/*.php

# But track these specific site JSON files
!sites/*/config.json
!sites/*-anchor-pools.json
!sites/*/queue.json
!sites/*-linker.json
!sites/*-business-facts.md

# Rendered output (site-specific, regenerated from templates)
modules/*/rendered/

# Audit reports (site-specific, regenerated on each run)
modules/*/reports/

# Generated data (site-specific, regenerated by tools)
modules/*/data/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp
*~

# Build artifacts
node_modules/
*.log

# Backups
*.bak
*.bak-*
backups/

# Audit artifacts (regenerated per run)
audit/

# Transient data files
*.csv
jobs/
job-types/
state/
test-results/
listing-data/
listing-templates/

# Generated featured images
featured-images/lrg/
featured-images/valn/
featured-images/canopy/
featured-images/gfp/

# Working docs (not canonical — canonical docs are in docs/)
*-todo.md
*-guides-to-be-created.md
page-creation-spec.md
modules/content-production-v2/LRG_content_queue.md

# Review sync module (WIP)
modules/reviews-sync/

# Spanish template (pipeline output, blocked by hook)
modules/content-production-v2/templates/lrg-spanish-article.html

# Sensitive
*.key
*.pem
secrets.json
modules/audit/lib/__pycache__/

# Python bytecode
__pycache__/
*.pyc
.env
.gsc-credentials.json
