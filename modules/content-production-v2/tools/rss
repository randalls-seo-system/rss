#!/usr/bin/env python3
"""RSS — Rank Logic SEO System CLI.

Usage:
    rss new-article --site <id> --topic "<topic>" [options]

Commands:
    new-article   Generate and deploy a new article as draft
"""

import argparse
import json
import sys
import time
from datetime import datetime
from pathlib import Path

MODULE_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(MODULE_DIR))

from lib.orchestrator import (
    create_job, load_job, save_job, job_dir, stage_done, mark_stage,
    validate_config, resolve_author, run_gates, gates_passed,
    create_draft_post, run_assemble, run_link_pass,
    deploy_draft, set_yoast_meta, purge_cache, verify_deploy,
    run_d2_claims_check, generate_from_capture, load_capture_transcript,
    resolve_unsourced_claims,
    PIPELINE_STAGES,
)
from lib.linker_core import deploy_lock


def cmd_new_article(args):
    start = time.time()

    # Load site config
    REPO_ROOT = MODULE_DIR.parent.parent
    config_path = REPO_ROOT / "sites" / args.site / "config.json"
    if not config_path.exists():
        print(f"ERROR: site config not found: {config_path}", file=sys.stderr)
        sys.exit(1)
    with open(config_path) as f:
        config = json.load(f)

    def log(msg):
        print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}", flush=True)

    # Resume or create job
    if args.resume:
        job = load_job(args.resume)
        log(f"Resuming job {job['id']} at first incomplete stage")
    else:
        job = create_job(args.site, args.topic)
        log(f"Created job {job['id']}")

    jd = job_dir(job)

    # ── Stage A: Config validate ──
    if not stage_done(job, "config"):
        log("Stage A: CONFIG LOAD + VALIDATE")
        missing = validate_config(config)
        if missing:
            log(f"FAIL: missing config fields: {', '.join(missing)}")
            mark_stage(job, "config", "failed", missing=missing)
            sys.exit(1)
        # Snapshot config
        with open(jd / "config-snapshot.json", "w") as f:
            json.dump(config, f, indent=2)
        mark_stage(job, "config", "done")
        log("  Config valid")

    # ── Stage B: Gap scan ──
    if not stage_done(job, "gap_scan"):
        if args.skip_gap_scan:
            log("Stage B: GAP SCAN (skipped)")
            mark_stage(job, "gap_scan", "skipped_flag", reason="--skip-gap-scan")
        else:
            log("Stage B: GAP SCAN")
            # Gap scan runs as part of assemble-article; we just note it
            mark_stage(job, "gap_scan", "done", note="integrated into assemble-article")
            log("  Gap scan will run inside assemble-article")

    # ── Stage C: Generate ──
    if not stage_done(job, "generate"):
        log("Stage C: GENERATE")

        # Create draft post if not already created
        if not job.get("post_id"):
            author_id, author_name = resolve_author(config, args.category or "")
            job["author_id"] = author_id
            log(f"  Author: {author_name} (ID {author_id})")

            log("  Creating draft post on server...")
            post_id = create_draft_post(config, args.topic, author_id)
            job["post_id"] = post_id
            job["post_slug"] = args.topic.lower().replace(" ", "-")[:60]
            save_job(job)
            log(f"  Draft post created: ID {post_id}")
            time.sleep(5)

        t0 = time.time()
        try:
            if args.source == "capture" and args.capture:
                log(f"  Generating from capture: {args.capture}")
                article_path = generate_from_capture(job, config, args.capture)
            else:
                log("  Running assemble-article.py...")
                article_path = run_assemble(job, config, skip_gap=args.skip_gap_scan)
        except (RuntimeError, FileNotFoundError, ValueError) as e:
            log(f"  FAIL: {e}")
            mark_stage(job, "generate", "failed", error=str(e))
            sys.exit(1)
        duration = time.time() - t0

        wc = len(article_path.read_text().split())
        mark_stage(job, "generate", "done", duration_s=round(duration), word_count=wc,
                   source=args.source or "serp")
        job["artifacts"] = job.get("artifacts", {})
        job["artifacts"]["article_html"] = str(article_path)
        save_job(job)
        log(f"  Generated: {wc} words in {duration:.0f}s")

    # ── Stage D: Emit gates ──
    if not stage_done(job, "gates"):
        log("Stage D: EMIT GATES")
        article_path = Path(job["artifacts"]["article_html"])
        html = article_path.read_text()
        results = run_gates(html, config)

        with open(jd / "gate-results.json", "w") as f:
            json.dump(results, f, indent=2)

        if gates_passed(results):
            mark_stage(job, "gates", "done", results=results)
            log("  All gates passed")
        else:
            failures = {k: v for k, v in results.items() if not v.startswith("pass")}
            log(f"  GATE FAILURES: {json.dumps(failures, indent=2)}")
            mark_stage(job, "gates", "failed", results=results)
            sys.exit(1)

    # ── Stage D2: Claims verification ──
    if not stage_done(job, "claims_check"):
        log("Stage D2: CLAIMS VERIFICATION")
        article_path = Path(job["artifacts"]["article_html"])
        html = article_path.read_text()

        # In capture mode, pass transcript as source for SME-SOURCED classification
        transcript_text = ""
        if args.source == "capture" and args.capture:
            try:
                story, qualify = load_capture_transcript(args.capture)
                transcript_text = f"{story}\n\n{qualify}".strip()
                log(f"  Transcript loaded ({len(transcript_text.split())}w) for SME-SOURCED classification")
            except Exception as e:
                log(f"  WARN: could not load transcript for D2: {e}")

        d2 = run_d2_claims_check(html, config, job, transcript_text=transcript_text)

        vent_count = len(d2["ventriloquism_hits"])
        unsourced = d2["unsourced_count"]
        sme_sourced = d2.get("sme_sourced_count", 0)
        total = d2["total_claims"]
        log(f"  Claims extracted: {total}")
        log(f"  Policy: {d2['policy_count']}, Source: {d2['source_count']}, SME-sourced: {sme_sourced}, UNSOURCED: {unsourced}")
        log(f"  Ventriloquism: {vent_count} hits" + (f" (LICENSED)" if d2.get("ventriloquism_licensed") else ""))

        if vent_count > 0:
            licensed = d2.get("ventriloquism_licensed", False)
            if licensed:
                log(f"  Ventriloquism: {vent_count} hits (LICENSED — first person preserved)")
            else:
                log("  VENTRILOQUISM GATE FAILED:")
                for h in d2["ventriloquism_hits"]:
                    log(f"    line ~{h['line_approx']}: \"{h['matched']}\" — ...{h['context']}...")

        if unsourced > 0:
            log(f"  UNSOURCED CLAIMS ({unsourced}):")
            for c in d2["classified_claims"]:
                if c.get("classification") == "UNSOURCED":
                    log(f"    [{c.get('section','')}] \"{c['claim'][:80]}\"")
                    if c.get("suggestion"):
                        log(f"      suggestion: {c['suggestion'][:100]}")

        if d2["passed"]:
            mark_stage(job, "claims_check", "done",
                       total_claims=total, unsourced=unsourced, sme_sourced=sme_sourced,
                       ventriloquism=vent_count)
            log("  D2 PASSED")
        else:
            # Auto-resolve: neutralize/remove unsourced claims (logged)
            if unsourced > 0:
                log(f"  D2 BLOCKED — {unsourced} unsourced. Applying auto-resolution...")
                article_path = Path(job["artifacts"]["article_html"])
                _, resolutions, unresolved = resolve_unsourced_claims(job, article_path, mode="remove")
                for r in resolutions:
                    log(f"    {r['action']}: \"{r['claim'][:60]}\"")
                for u in unresolved:
                    log(f"    UNRESOLVED ({u['reason']}): \"{u['claim'][:60]}\"")

                # Write safi-questions for removed AND unresolved claims
                questions = [r for r in resolutions if r["action"].startswith("removed")]
                q_path = job_dir(job) / f"safi-questions-{job.get('post_slug', job['id'][:20])}.md"
                q_lines = [f"# Safi Questions — {job['topic']}\n\nClaims removed by D2 (need Safi confirmation before publish):\n"]
                for i, q in enumerate(questions, 1):
                    q_lines.append(f"{i}. **\"{q['claim']}\"** — {q.get('reason', 'UNSOURCED')}\n")
                if unresolved:
                    q_lines.append(f"\n## Claims the resolver could NOT act on — still in the article\n")
                    for i, u in enumerate(unresolved, 1):
                        q_lines.append(f"{i}. **\"{u['claim']}\"** [{u['section']}] — {u['reason']}: pattern `{u['pattern_tried'][:40]}…`\n")
                if questions or unresolved:
                    q_path.write_text("\n".join(q_lines))
                    log(f"  Safi questions: {q_path.name}")

                fully_resolved = len(unresolved) == 0
                status = "done" if fully_resolved else "fail_unresolved"
                mark_stage(job, "claims_check", status,
                           total_claims=total, unsourced=unsourced, sme_sourced=sme_sourced,
                           ventriloquism=vent_count,
                           resolutions=len(resolutions),
                           unresolved_count=len(unresolved),
                           unresolved=unresolved,
                           fully_resolved=fully_resolved,
                           note=f"{len(resolutions)} resolved, {len(unresolved)} unresolved")
                log(f"  D2 resolved: {len(resolutions)} claims handled, {len(unresolved)} unresolved")
            else:
                # Only ventriloquism (should be licensed)
                mark_stage(job, "claims_check", "done",
                           total_claims=total, unsourced=0, sme_sourced=sme_sourced,
                           ventriloquism=vent_count, ventriloquism_licensed=True)
                log("  D2 PASSED (ventriloquism licensed)")

    # ── Stage E: Link pass ──
    if not stage_done(job, "link_pass"):
        log("Stage E: LINK PASS")
        try:
            linked_path, links_injected = run_link_pass(job, config)
        except RuntimeError as e:
            log(f"  WARN: link pass failed ({e}) — proceeding with unlinked article")
            linked_path = Path(job["artifacts"]["article_html"])
            links_injected = 0

        mark_stage(job, "link_pass", "done", links_injected=links_injected)
        job["artifacts"]["article_linked"] = str(linked_path)
        save_job(job)
        log(f"  {links_injected} links injected")

    # ── Stage E2: Adversarial review (config-gated) ──
    review_config = config.get("content", {}).get("adversarial_review", {})
    review_enabled = review_config.get("enabled", False)
    review_types = review_config.get("content_types", ["article"])
    content_type = job.get("content_type", "article")

    if review_enabled and content_type in review_types and not stage_done(job, "adversarial_review"):
        log("Stage E2: ADVERSARIAL REVIEW")

        # Validate post_id before review — no deploy artifact needed at E2
        import importlib.util as _ar_ilu
        _ar_res_spec = _ar_ilu.spec_from_file_location(
            "artifact_resolver", REPO_ROOT / "lib" / "artifact_resolver.py")
        _ar_res_mod = _ar_ilu.module_from_spec(_ar_res_spec)
        _ar_res_spec.loader.exec_module(_ar_res_mod)
        try:
            post_id = _ar_res_mod.validate_post_id(job)
        except _ar_res_mod.ArtifactResolutionError as e:
            log(f"  BLOCKED: {e}")
            mark_stage(job, "adversarial_review", "failed", error=str(e))
            sys.exit(1)

        linked_path = Path(job["artifacts"].get("article_linked", job["artifacts"]["article_html"]))
        review_html = linked_path.read_text()

        # Load claims policy
        policy_text = ""
        policy_path = config.get("content", {}).get("claims_policy", "")
        if policy_path:
            expanded = Path(policy_path).expanduser()
            if not expanded.is_absolute():
                expanded = REPO_ROOT / policy_path
            if expanded.exists():
                policy_text = expanded.read_text()[:3000]

        import importlib.util as _ilu
        _ar_spec = _ilu.spec_from_file_location("adversarial_review", REPO_ROOT / "lib" / "adversarial_review.py")
        _ar_mod = _ilu.module_from_spec(_ar_spec)
        _ar_spec.loader.exec_module(_ar_mod)

        try:
            review_result = _ar_mod.run_review_cycle(
                review_html,
                site_slug=args.site,
                content_type=content_type,
                target_keyword=job["topic"],
                claims_policy_text=policy_text,
                model=review_config.get("model", "gpt-5.6"),
                config=config,
                job_dir=jd,
                post_id=post_id,
            )

            log(f"  Review: {review_result.review_calls} calls, cost=${review_result.total_cost:.4f}")
            log(f"  Fixes applied: {len([f for f in review_result.fixes_applied if f.status in ('verified', 'subtractive_no_auth')])}")
            log(f"  Advisory: {len(review_result.advisory_additions)} items")

            if review_result.revised_html and review_result.revised_html != review_html:
                reviewed_path = jd / f"{post_id}-reviewed.html"
                reviewed_path.write_text(review_result.revised_html)
                job["artifacts"]["article_reviewed"] = str(reviewed_path)
                save_job(job)
                log(f"  Revised artifact saved: {reviewed_path.name}")

            mark_stage(job, "adversarial_review", "done",
                       review_calls=review_result.review_calls,
                       total_cost=review_result.total_cost,
                       confirmation_passed=review_result.confirmation_passed)

            if not review_result.confirmation_passed:
                # Unresolved criticals = PARK. "We know this claim is wrong
                # and shipped anyway" is not an advisory situation.
                log(f"  REVIEW PARKED — unresolved criticals: {review_result.confirmation_unresolved}")
                log(f"  Job will NOT proceed to deploy. Review the advisory file and re-run.")
                mark_stage(job, "adversarial_review", "parked",
                           unresolved=review_result.confirmation_unresolved)
                sys.exit(1)
        except Exception as e:
            # Infrastructure failure (OpenAI down, malformed JSON after retry)
            # = non-blocking. Article proceeds through gates.
            log(f"  REVIEW INFRASTRUCTURE FAILURE (non-blocking): {e}")
            mark_stage(job, "adversarial_review", "failed", error=str(e))
    elif not stage_done(job, "adversarial_review"):
        # L28: record WHY this stage was skipped — no silent vanishing
        if not review_enabled:
            reason = "content.adversarial_review.enabled not set or False"
        else:
            reason = f"content_type '{content_type}' not in review_types {review_types}"
        log(f"Stage E2: ADVERSARIAL REVIEW (skipped — {reason})")
        mark_stage(job, "adversarial_review", "skipped_config", reason=reason)

    if args.dry_run:
        log("\nDRY RUN — stopping before deploy")
        # L28: record not_reached for stages that won't run
        for _s in ("deploy", "verify", "log"):
            if not stage_done(job, _s):
                mark_stage(job, _s, "not_reached", reason="dry-run")
        job["completed"] = datetime.now().isoformat()
        job["wall_clock_s"] = round(time.time() - start)
        save_job(job)
        log(f"Job {job['id']} complete (dry-run, {job['wall_clock_s']}s)")
        return

    # ── Stage F: Deploy ──
    if not stage_done(job, "deploy"):
        log("Stage F: DEPLOY")
        linked_path = Path(job["artifacts"].get("article_linked", job["artifacts"]["article_html"]))

        ok = deploy_draft(job, config, linked_path)
        if not ok:
            log("  DEPLOY FAILED")
            mark_stage(job, "deploy", "failed")
            sys.exit(1)

        time.sleep(5)

        # Yoast meta (best effort)
        topic = job["topic"]
        title = f"{topic} | {config.get('identity', {}).get('name', '')}"
        desc = f"Learn about {topic.lower()}. Expert guide from {config.get('identity', {}).get('name', '')}."
        try:
            set_yoast_meta(config, job["post_id"], title[:70], desc[:160])
            log("  Yoast meta set")
        except Exception as e:
            log(f"  WARN: Yoast meta failed: {e}")

        purge_cache(config)
        log("  Cache purged")
        mark_stage(job, "deploy", "done", post_id=job["post_id"])
        log(f"  Deployed as draft: post ID {job['post_id']}")

    # ── Stage G: Verify ──
    if not stage_done(job, "verify"):
        log("Stage G: VERIFY")
        checks = verify_deploy(job, config)
        mark_stage(job, "verify", "done", checks=checks)
        for k, v in checks.items():
            status = "OK" if v.startswith("pass") else v
            log(f"  {k}: {status}")

    # ── Stage H: Log ──
    if not stage_done(job, "log"):
        log("Stage H: LOG")
        job["completed"] = datetime.now().isoformat()
        job["wall_clock_s"] = round(time.time() - start)
        mark_stage(job, "log", "done")
        save_job(job)
        log(f"  Job record written: {jd / 'job.json'}")

    # Summary
    log(f"\n{'='*60}")
    log(f"JOB COMPLETE: {job['id']}")
    log(f"{'='*60}")
    log(f"Site:       {job['site']}")
    log(f"Topic:      {job['topic']}")
    log(f"Post ID:    {job['post_id']}")
    log(f"Author:     {job['author_id']}")
    log(f"Wall clock: {job['wall_clock_s']}s")
    for stage, data in job.get("stages", {}).items():
        extra = ""
        if "duration_s" in data:
            extra += f" ({data['duration_s']}s)"
        if "links_injected" in data:
            extra += f" ({data['links_injected']} links)"
        if "word_count" in data:
            extra += f" ({data['word_count']} words)"
        log(f"  {stage:15s} {data['status']}{extra}")
    log(f"Job dir:    {jd}")


def cmd_doctor(args):
    """Run readiness diagnostics for a site."""
    REPO_ROOT = MODULE_DIR.parent.parent
    config_path = REPO_ROOT / "sites" / args.site / "config.json"
    checks = {}

    # 1. Config loads
    if not config_path.exists():
        checks["config"] = "FAIL: config not found"
        _doctor_report(checks, args.json)
        sys.exit(1)
    with open(config_path) as f:
        config = json.load(f)

    # 2. Config validation (no TODO fields in required paths)
    missing = validate_config(config)
    checks["config_validate"] = "pass" if not missing else f"FAIL: {', '.join(missing)}"

    # 3. CSS prefix — real values
    css_pfx = config.get("content", {}).get("css_prefix", [])
    if not css_pfx or any("TODO" in str(p) for p in css_pfx):
        checks["css_prefix"] = f"FAIL: css_prefix is {css_pfx}"
    else:
        checks["css_prefix"] = "pass"

    # 4. Postprocessor
    post_tool_candidates = [
        REPO_ROOT / "tools" / f"{args.site}-postprocess.py",
        MODULE_DIR / "tools" / f"{args.site}-postprocess.py",
    ]
    if any(p.exists() for p in post_tool_candidates):
        checks["postprocessor"] = "pass"
    else:
        checks["postprocessor"] = "WARN: no postprocessor found (may not be needed)"

    # 5. Business-facts file
    facts = REPO_ROOT / "sites" / f"{args.site}-business-facts.md"
    checks["business_facts"] = "pass" if facts.exists() else "WARN: no business-facts file (H.27 handles)"

    # 6. Claims policy
    policy_path = config.get("content", {}).get("claims_policy", "")
    if policy_path:
        expanded = Path(policy_path).expanduser()
        checks["claims_policy"] = "pass" if expanded.exists() else f"FAIL: declared {policy_path} not found"
    else:
        checks["claims_policy"] = "pass (none declared)"

    # 7. Anchor pool
    pool_path_cfg = config.get("linking", {}).get("pool_path", "")
    pool_path = REPO_ROOT / pool_path_cfg if pool_path_cfg else REPO_ROOT / "sites" / f"{args.site}-anchor-pools.json"
    if pool_path.exists():
        try:
            data = json.loads(pool_path.read_text())
            checks["anchor_pool"] = f"pass ({len(data.get('destinations', data if isinstance(data, list) else []))} destinations)"
        except (json.JSONDecodeError, TypeError):
            checks["anchor_pool"] = "FAIL: anchor pool exists but is invalid JSON"
    else:
        checks["anchor_pool"] = "WARN: no anchor pool (pool-mode links will be zero)"

    # 8. Environment — NLTK + required packages
    env_issues = []
    try:
        import nltk
        nltk.data.find("taggers/averaged_perceptron_tagger_eng")
    except (ImportError, LookupError):
        env_issues.append("NLTK tagger data missing (run tools/setup-env.sh)")
    for pkg in ("bs4", "requests", "yaml"):
        try:
            __import__(pkg)
        except ImportError:
            env_issues.append(f"{pkg} not installed")
    checks["environment"] = "pass" if not env_issues else f"FAIL: {'; '.join(env_issues)}"

    # 9. Deploy — SSH connectivity
    ssh_host = config.get("access", {}).get("ssh_host", "")
    ssh_user = config.get("access", {}).get("ssh_user", "")
    ssh_key = config.get("access", {}).get("ssh_key_path", "")
    wp_path = config.get("access", {}).get("wp_path", "")
    if ssh_host and ssh_user:
        import subprocess
        key_path = Path(ssh_key).expanduser() if ssh_key else None
        ssh_cmd = ["ssh", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes",
                   "-o", "StrictHostKeyChecking=accept-new"]
        if key_path and key_path.exists():
            ssh_cmd += ["-i", str(key_path), "-o", "IdentitiesOnly=yes"]
        ssh_cmd += [f"{ssh_user}@{ssh_host}", f"test -d {wp_path} && echo ok"]
        try:
            r = subprocess.run(ssh_cmd, capture_output=True, text=True, timeout=30)
            if r.returncode == 0 and "ok" in r.stdout:
                checks["deploy_ssh"] = "pass"
            else:
                checks["deploy_ssh"] = f"FAIL: SSH returned {r.returncode}: {r.stderr[:100]}"
        except subprocess.TimeoutExpired:
            checks["deploy_ssh"] = "FAIL: SSH timed out"
        except Exception as e:
            checks["deploy_ssh"] = f"FAIL: {e}"
    else:
        checks["deploy_ssh"] = "FAIL: ssh_host or ssh_user not configured"

    # 10. Topic graph prerequisites — post inventory + GSC query cache
    inv_path = REPO_ROOT / "sites" / args.site / "post-inventory.json"
    if inv_path.exists():
        try:
            inv_data = json.loads(inv_path.read_text())
            checks["post_inventory"] = f"pass ({len(inv_data)} posts)"
        except json.JSONDecodeError:
            checks["post_inventory"] = "FAIL: post-inventory.json is invalid JSON"
    else:
        checks["post_inventory"] = "WARN: no post-inventory.json (resolve-pending-links will fail closed)"

    gsc_prop = config.get("integrations", {}).get("gsc_property", "")
    if gsc_prop:
        docs_dir = REPO_ROOT / "docs"
        audit_files = sorted(docs_dir.glob(f"{args.site}-audit-*.json"), reverse=True)
        has_audit_queries = False
        if audit_files:
            try:
                aud = json.loads(audit_files[0].read_text())
                has_audit_queries = any(r.get("top_query") for r in aud.get("results", []))
            except Exception:
                pass
        if has_audit_queries:
            checks["gsc_query_cache"] = "pass (from audit)"
        else:
            checks["gsc_query_cache"] = (
                "WARN: GSC configured but no audit with query data found. "
                "Run: rss audit-batch --site " + args.site + " --top 50 "
                "(resolver linked_existing will miss GSC signal until then)"
            )

    _doctor_report(checks, args.json)
    has_fail = any(v.startswith("FAIL") for v in checks.values())
    sys.exit(1 if has_fail else 0)


def _doctor_report(checks: dict, as_json: bool):
    if as_json:
        print(json.dumps(checks, indent=2))
        return
    for name, result in checks.items():
        if result.startswith("FAIL"):
            icon = "\033[31mFAIL\033[0m"
        elif result.startswith("WARN"):
            icon = "\033[33mWARN\033[0m"
        else:
            icon = "\033[32m OK \033[0m"
        print(f"  [{icon}] {name}: {result}")


def cmd_audit(args):
    """Audit a single post or batch of posts against the quality stack."""
    from lib.auditor import (
        audit_post, fetch_gsc_top_pages, fetch_slug_to_id_map,
        write_audit_report, fetch_post_html,
    )
    import time

    config_path = MODULE_DIR.parent.parent / "sites" / args.site / "config.json"
    if not config_path.exists():
        print(f"Config not found: {config_path}", file=sys.stderr)
        sys.exit(1)
    config = json.loads(config_path.read_text())

    # Protected pages
    do_not_touch = {
        p["post_id"]
        for p in config.get("protected", {}).get("do_not_touch_pages", [])
    }

    if hasattr(args, "post_id") and args.post_id:
        # Single-post audit
        if args.post_id in do_not_touch:
            print(f"Post {args.post_id} is in do_not_touch_pages, skipping.")
            return
        result = audit_post(config, args.post_id, force_tier2=getattr(args, "full", False))
        if result is None:
            print(f"Could not fetch post {args.post_id}")
            sys.exit(1)
        md_path, json_path = write_audit_report([result], args.site)
        _print_single_audit(result)
        print(f"\nReport: {md_path}")

    elif hasattr(args, "top") and args.top:
        # Batch audit
        print(f"Fetching top {args.top} pages from GSC...", file=sys.stderr)
        gsc_pages = fetch_gsc_top_pages(config, limit=args.top)
        if not gsc_pages:
            print("No GSC data available.")
            sys.exit(1)

        print(f"Got {len(gsc_pages)} pages. Resolving post IDs...", file=sys.stderr)

        # Batch resolve: one SSH call for full slug→ID map
        slug_map = fetch_slug_to_id_map(config)
        print(f"  Slug map: {len(slug_map)} posts", file=sys.stderr)

        audit_targets = []
        for gp in gsc_pages:
            slug = gp["slug"]
            pid = slug_map.get(slug)
            if pid is None:
                print(f"  SKIP: {slug} (no post_id found)", file=sys.stderr)
                continue
            if pid in do_not_touch:
                print(f"  SKIP: {slug} (do_not_touch)", file=sys.stderr)
                continue
            gp["post_id"] = pid
            audit_targets.append(gp)

        print(f"\n{len(audit_targets)} posts to audit.\n", file=sys.stderr)

        results = []
        for i, target in enumerate(audit_targets):
            pid = target["post_id"]
            slug = target["slug"]
            print(f"  [{i+1}/{len(audit_targets)}] {slug} (ID {pid})...", file=sys.stderr, end="", flush=True)
            r = audit_post(
                config, pid, gsc_data=target,
                force_tier2=getattr(args, "full", False),
            )
            if r:
                results.append(r)
                print(f" {r.verdict} ({r.hard_pass_count}/{r.hard_total_count} hard)", file=sys.stderr)
            else:
                print(f" FETCH FAILED", file=sys.stderr)
            time.sleep(1)  # SSH pacing

        if results:
            md_path, json_path = write_audit_report(results, args.site)
            _print_batch_summary(results)
            print(f"\nFull report: {md_path}")
            print(f"JSON data:   {json_path}")
        else:
            print("No posts could be audited.")

    else:
        print("Specify --post-id N or --top N")
        sys.exit(1)


def _print_single_audit(r):
    """Print a single audit result."""
    print(f"\n{'='*60}")
    print(f"Post {r.post_id}: {r.slug}")
    print(f"Title: {r.title[:60]}")
    print(f"Verdict: {r.verdict}")
    print(f"Hard assertions: {r.hard_pass_count}/{r.hard_total_count}")
    print(f"Soft assertions: {r.soft_pass_count}/{r.soft_total_count}")
    if r.hard_failures:
        print(f"\nHard failures:")
        for f in r.hard_failures:
            print(f"  - {f}")
    if r.quality_gate_failures:
        print(f"\nQuality gate failures:")
        for f in r.quality_gate_failures:
            print(f"  - {f[:100]}")
    if r.artifact_hits:
        print(f"\nArtifacts:")
        for f in r.artifact_hits:
            print(f"  - {f[:100]}")
    if r.tier2_ran:
        print(f"\nClaims: {r.claim_count} total, {r.unsourced_claims} unsourced, {r.volatile_claims} volatile")


def _print_batch_summary(results):
    """Print batch audit summary."""
    refresh = [r for r in results if r.verdict == "REFRESH"]
    review = [r for r in results if r.verdict == "REVIEW"]
    passing = [r for r in results if r.verdict == "PASS"]

    print(f"\n{'='*60}")
    print(f"AUDIT SUMMARY: {len(results)} posts")
    print(f"  REFRESH: {len(refresh)}")
    print(f"  REVIEW:  {len(review)}")
    print(f"  PASS:    {len(passing)}")

    if refresh:
        print(f"\nREFRESH candidates (worst first):")
        for r in refresh[:10]:
            print(f"  {r.post_id:>5} {r.slug[:35]:35s}  pos={r.position:<5.0f} imp={r.impressions:<5}  {'; '.join(r.verdict_reasons[:2])[:60]}")

    if review:
        print(f"\nREVIEW (human decides):")
        for r in review[:10]:
            print(f"  {r.post_id:>5} {r.slug[:35]:35s}  pos={r.position:<5.0f} imp={r.impressions:<5}  {'; '.join(r.verdict_reasons[:2])[:60]}")


