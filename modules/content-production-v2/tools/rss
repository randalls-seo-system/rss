def cmd_queue(args):
    """Queue management subcommands."""
    from lib.queue import (
        load_queue, save_queue, add_item, add_refresh_item, list_items,
        park_item, retry_item, seed_from_gsc, seed_from_audit,
    )
    REPO_ROOT = MODULE_DIR.parent.parent

    if args.queue_action == "add":
        if getattr(args, "refresh", False) and getattr(args, "post_id", None):
            item = add_refresh_item(args.site, args.post_id,
                                    keyword=getattr(args, "keyword", "") or "")
            print(f"Added refresh: {item['id']} — post {args.post_id}")
        else:
            item = add_item(args.site, args.topic, keyword=args.keyword or args.topic,
                            intent_hint=getattr(args, "intent", ""))
            print(f"Added: {item['id']} — {item['target_keyword']}")

    elif args.queue_action == "list":
        items = list_items(args.site, status=getattr(args, "status", None))
        # Filter by origin if specified
        origin_filter = getattr(args, "origin", None)
        if origin_filter:
            items = [i for i in items if i.get("origin") == origin_filter]
        if not items:
            print("Queue is empty.")
            return
        for it in items:
            notes_count = len(it.get("backlink_notes", []))
            notes_str = f"  notes={notes_count}" if notes_count else ""
            origin_str = f"  origin={it['origin']}" if it.get("origin") else ""
            print(f"  [{it['status']:12s}] {it['id'][:12]}  {it['target_keyword'][:50]}"
                  f"  attempts={it.get('attempts', 0)}{origin_str}{notes_str}")

    elif args.queue_action == "seed":
        candidates = seed_from_gsc(
            args.site,
            min_impressions=getattr(args, "min_impressions", 50),
            limit=getattr(args, "limit", 30),
        )
        if not candidates:
            print("No candidates from GSC.")
            return
        new_candidates = [c for c in candidates if c.get("flag") == "NEW"]
        refresh_candidates = [c for c in candidates if c.get("flag") == "REFRESH"]

        if new_candidates:
            print(f"\n{len(new_candidates)} NEW candidates (no existing page owns the query):\n")
            for i, c in enumerate(new_candidates, 1):
                print(f"  {i:3d}. [{c.get('impressions', '?'):>5} imp] {c['query']}")

        if refresh_candidates:
            print(f"\n{len(refresh_candidates)} REFRESH candidates (existing page receives impressions — do NOT seed):\n")
            for i, c in enumerate(refresh_candidates, 1):
                owner = c.get("owning_page", "?")
                pos = c.get("owning_position", "?")
                print(f"  {i:3d}. [{c.get('impressions', '?'):>5} imp] {c['query']}  → {owner} (pos {pos})")

        if not new_candidates:
            print(f"\nAll {len(candidates)} candidates map to existing pages. Seed yields no new content.")
            print("Consider refreshing the listed pages instead.")
            return

        print(f"\nTo write the {len(new_candidates)} NEW candidates to queue, re-run with --confirm")
        if getattr(args, "confirm", False):
            from lib.queue import add_item
            added = 0
            for c in new_candidates:
                add_item(args.site, c["query"], keyword=c["query"])
                added += 1
            print(f"\nAdded {added} items to queue (refresh candidates excluded).")

    elif args.queue_action == "seed-refresh":
        candidates, excluded = seed_from_audit(args.site, limit=getattr(args, "limit", 20))

        if excluded:
            # Group excluded by reason type
            non_articles = [e for e in excluded if "page_type" in e.get("reason", "")]
            frozen = [e for e in excluded if "frozen" in e.get("reason", "")]
            other_excl = [e for e in excluded if e not in non_articles and e not in frozen]

            if non_articles:
                print(f"\n--- Non-article pages needing attention ({len(non_articles)}) ---")
                for e in non_articles:
                    print(f"  {e['post_id']:>5}  {e['slug'][:40]:40}  {e['reason']}")

            if frozen:
                print(f"\n--- Frozen (pos 1-10, ineligible until manually lifted) ({len(frozen)}) ---")
                for e in frozen:
                    print(f"  {e['post_id']:>5}  {e['slug'][:40]:40}  pos={e['position']:.0f}  imp={e['impressions']}")

            if other_excl:
                print(f"\n--- Other excluded ({len(other_excl)}) ---")
                for e in other_excl:
                    print(f"  {e['post_id']:>5}  {e['slug'][:40]:40}  {e['reason']}")

        if not candidates:
            print("\nNo eligible refresh candidates.")
            return

        print(f"\n--- {len(candidates)} eligible article refresh candidates (risk-first ranking) ---\n")
        print(f"  {'#':>3}  {'Score':>6}  {'Post ID':>7}  {'Slug':35}  {'Pos':>5}  {'Imp':>6}  {'Unsrc':>5}  {'Hard':>4}")
        for i, c in enumerate(candidates, 1):
            print(f"  {i:3d}  {c['score']:6.0f}  {c['post_id']:>7}  {c['slug'][:35]:35}  {c['position']:5.0f}  {c['impressions']:>6}  {c['unsourced_claims']:>5}  {c['hard_failures']:>4}")

        print(f"\nTo write to queue, re-run with --confirm")
        if getattr(args, "confirm", False):
            added = 0
            for c in candidates:
                add_refresh_item(args.site, c["post_id"],
                                 keyword=c.get("top_query", ""),
                                 slug=c.get("slug", ""))
                added += 1
            print(f"\nAdded {added} refresh items to queue.")

    elif args.queue_action == "park":
        park_item(args.site, args.id)
        print(f"Parked: {args.id}")

    elif args.queue_action == "retry":
        retry_item(args.site, args.id)
        print(f"Retried (reset to pending): {args.id}")


