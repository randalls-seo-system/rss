#!/usr/bin/env python3
"""RSS — Rank Logic SEO System CLI.

Usage:
    rss new-article --site <id> --topic "<topic>" [options]

Commands:
    new-article   Generate and deploy a new article as draft
"""

import argparse
import json
import sys
import time
from datetime import datetime
from pathlib import Path

MODULE_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(MODULE_DIR))

from lib.orchestrator import (
    create_job, load_job, save_job, job_dir, stage_done, mark_stage,
    validate_config, resolve_author, run_gates, gates_passed,
    create_draft_post, run_assemble, run_link_pass,
    deploy_draft, set_yoast_meta, purge_cache, verify_deploy,
    run_d2_claims_check, generate_from_capture, load_capture_transcript,
    resolve_unsourced_claims,
)
from lib.linker_core import deploy_lock


def cmd_new_article(args):
    start = time.time()

    # Load site config
    REPO_ROOT = MODULE_DIR.parent.parent
    config_path = REPO_ROOT / "sites" / args.site / "config.json"
    if not config_path.exists():
        print(f"ERROR: site config not found: {config_path}", file=sys.stderr)
        sys.exit(1)
    with open(config_path) as f:
        config = json.load(f)

    def log(msg):
        print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}", flush=True)

    # Resume or create job
    if args.resume:
        job = load_job(args.resume)
        log(f"Resuming job {job['id']} at first incomplete stage")
    else:
        job = create_job(args.site, args.topic)
        log(f"Created job {job['id']}")

    jd = job_dir(job)

    # ── Stage A: Config validate ──
    if not stage_done(job, "config"):
        log("Stage A: CONFIG LOAD + VALIDATE")
        missing = validate_config(config)
        if missing:
            log(f"FAIL: missing config fields: {', '.join(missing)}")
            mark_stage(job, "config", "failed", missing=missing)
            sys.exit(1)
        # Snapshot config
        with open(jd / "config-snapshot.json", "w") as f:
            json.dump(config, f, indent=2)
        mark_stage(job, "config", "done")
        log("  Config valid")

    # ── Stage B: Gap scan ──
    if not stage_done(job, "gap_scan"):
        if args.skip_gap_scan:
            log("Stage B: GAP SCAN (skipped)")
            mark_stage(job, "gap_scan", "done", skipped=True)
        else:
            log("Stage B: GAP SCAN")
            # Gap scan runs as part of assemble-article; we just note it
            mark_stage(job, "gap_scan", "done", note="integrated into assemble-article")
            log("  Gap scan will run inside assemble-article")

    # ── Stage C: Generate ──
    if not stage_done(job, "generate"):
        log("Stage C: GENERATE")

        # Create draft post if not already created
        if not job.get("post_id"):
            author_id, author_name = resolve_author(config, args.category or "")
            job["author_id"] = author_id
            log(f"  Author: {author_name} (ID {author_id})")

            log("  Creating draft post on server...")
            post_id = create_draft_post(config, args.topic, author_id)
            job["post_id"] = post_id
            job["post_slug"] = args.topic.lower().replace(" ", "-")[:60]
            save_job(job)
            log(f"  Draft post created: ID {post_id}")
            time.sleep(5)

        t0 = time.time()
        try:
            if args.source == "capture" and args.capture:
                log(f"  Generating from capture: {args.capture}")
                article_path = generate_from_capture(job, config, args.capture)
            else:
                log("  Running assemble-article.py...")
                article_path = run_assemble(job, config, skip_gap=args.skip_gap_scan)
        except (RuntimeError, FileNotFoundError, ValueError) as e:
            log(f"  FAIL: {e}")
            mark_stage(job, "generate", "failed", error=str(e))
            sys.exit(1)
        duration = time.time() - t0

        wc = len(article_path.read_text().split())
        mark_stage(job, "generate", "done", duration_s=round(duration), word_count=wc,
                   source=args.source or "serp")
        job["artifacts"] = job.get("artifacts", {})
        job["artifacts"]["article_html"] = str(article_path)
        save_job(job)
        log(f"  Generated: {wc} words in {duration:.0f}s")

    # ── Stage D: Emit gates ──
    if not stage_done(job, "gates"):
        log("Stage D: EMIT GATES")
        article_path = Path(job["artifacts"]["article_html"])
        html = article_path.read_text()
        results = run_gates(html, config)

        with open(jd / "gate-results.json", "w") as f:
            json.dump(results, f, indent=2)

        if gates_passed(results):
            mark_stage(job, "gates", "done", results=results)
            log("  All gates passed")
        else:
            failures = {k: v for k, v in results.items() if not v.startswith("pass")}
            log(f"  GATE FAILURES: {json.dumps(failures, indent=2)}")
            mark_stage(job, "gates", "failed", results=results)
            sys.exit(1)

    # ── Stage D2: Claims verification ──
    if not stage_done(job, "claims_check"):
        log("Stage D2: CLAIMS VERIFICATION")
        article_path = Path(job["artifacts"]["article_html"])
        html = article_path.read_text()

        # In capture mode, pass transcript as source for SME-SOURCED classification
        transcript_text = ""
        if args.source == "capture" and args.capture:
            try:
                story, qualify = load_capture_transcript(args.capture)
                transcript_text = f"{story}\n\n{qualify}".strip()
                log(f"  Transcript loaded ({len(transcript_text.split())}w) for SME-SOURCED classification")
            except Exception as e:
                log(f"  WARN: could not load transcript for D2: {e}")

        d2 = run_d2_claims_check(html, config, job, transcript_text=transcript_text)

        vent_count = len(d2["ventriloquism_hits"])
        unsourced = d2["unsourced_count"]
        sme_sourced = d2.get("sme_sourced_count", 0)
        total = d2["total_claims"]
        log(f"  Claims extracted: {total}")
        log(f"  Policy: {d2['policy_count']}, Source: {d2['source_count']}, SME-sourced: {sme_sourced}, UNSOURCED: {unsourced}")
        log(f"  Ventriloquism: {vent_count} hits" + (f" (LICENSED)" if d2.get("ventriloquism_licensed") else ""))

        if vent_count > 0:
            licensed = d2.get("ventriloquism_licensed", False)
            if licensed:
                log(f"  Ventriloquism: {vent_count} hits (LICENSED — first person preserved)")
            else:
                log("  VENTRILOQUISM GATE FAILED:")
                for h in d2["ventriloquism_hits"]:
                    log(f"    line ~{h['line_approx']}: \"{h['matched']}\" — ...{h['context']}...")

        if unsourced > 0:
            log(f"  UNSOURCED CLAIMS ({unsourced}):")
            for c in d2["classified_claims"]:
                if c.get("classification") == "UNSOURCED":
                    log(f"    [{c.get('section','')}] \"{c['claim'][:80]}\"")
                    if c.get("suggestion"):
                        log(f"      suggestion: {c['suggestion'][:100]}")

        if d2["passed"]:
            mark_stage(job, "claims_check", "done",
                       total_claims=total, unsourced=unsourced, sme_sourced=sme_sourced,
                       ventriloquism=vent_count)
            log("  D2 PASSED")
        else:
            # Auto-resolve: neutralize/remove unsourced claims (logged)
            if unsourced > 0:
                log(f"  D2 BLOCKED — {unsourced} unsourced. Applying auto-resolution...")
                article_path = Path(job["artifacts"]["article_html"])
                _, resolutions = resolve_unsourced_claims(job, article_path, mode="remove")
                for r in resolutions:
                    log(f"    {r['action']}: \"{r['claim'][:60]}\"")

                # Write safi-questions for removed claims
                questions = [r for r in resolutions if r["action"].startswith("removed")]
                if questions:
                    q_path = job_dir(job) / f"safi-questions-{job.get('post_slug', job['id'][:20])}.md"
                    q_lines = [f"# Safi Questions — {job['topic']}\n\nClaims removed by D2 (need Safi confirmation before publish):\n"]
                    for i, q in enumerate(questions, 1):
                        q_lines.append(f"{i}. **\"{q['claim']}\"** — {q.get('reason', 'UNSOURCED')}\n")
                    q_path.write_text("\n".join(q_lines))
                    log(f"  Safi questions: {q_path.name}")

                mark_stage(job, "claims_check", "done",
                           total_claims=total, unsourced=unsourced, sme_sourced=sme_sourced,
                           ventriloquism=vent_count,
                           resolutions=len(resolutions),
                           note=f"{len(resolutions)} claims resolved (removed/neutralized)")
                log(f"  D2 resolved: {len(resolutions)} claims handled")
            else:
                # Only ventriloquism (should be licensed)
                mark_stage(job, "claims_check", "done",
                           total_claims=total, unsourced=0, sme_sourced=sme_sourced,
                           ventriloquism=vent_count, ventriloquism_licensed=True)
                log("  D2 PASSED (ventriloquism licensed)")

    # ── Stage E: Link pass ──
    if not stage_done(job, "link_pass"):
        log("Stage E: LINK PASS")
        try:
            linked_path, links_injected = run_link_pass(job, config)
        except RuntimeError as e:
            log(f"  WARN: link pass failed ({e}) — proceeding with unlinked article")
            linked_path = Path(job["artifacts"]["article_html"])
            links_injected = 0

        mark_stage(job, "link_pass", "done", links_injected=links_injected)
        job["artifacts"]["article_linked"] = str(linked_path)
        save_job(job)
        log(f"  {links_injected} links injected")

    if args.dry_run:
        log("\nDRY RUN — stopping before deploy")
        job["completed"] = datetime.now().isoformat()
        job["wall_clock_s"] = round(time.time() - start)
        save_job(job)
        log(f"Job {job['id']} complete (dry-run, {job['wall_clock_s']}s)")
        return

    # ── Stage F: Deploy ──
    if not stage_done(job, "deploy"):
        log("Stage F: DEPLOY")
        linked_path = Path(job["artifacts"].get("article_linked", job["artifacts"]["article_html"]))

        ok = deploy_draft(job, config, linked_path)
        if not ok:
            log("  DEPLOY FAILED")
            mark_stage(job, "deploy", "failed")
            sys.exit(1)

        time.sleep(5)

        # Yoast meta (best effort)
        topic = job["topic"]
        title = f"{topic} | {config.get('identity', {}).get('name', '')}"
        desc = f"Learn about {topic.lower()}. Expert guide from {config.get('identity', {}).get('name', '')}."
        try:
            set_yoast_meta(config, job["post_id"], title[:70], desc[:160])
            log("  Yoast meta set")
        except Exception as e:
            log(f"  WARN: Yoast meta failed: {e}")

        purge_cache(config)
        log("  Cache purged")
        mark_stage(job, "deploy", "done", post_id=job["post_id"])
        log(f"  Deployed as draft: post ID {job['post_id']}")

    # ── Stage G: Verify ──
    if not stage_done(job, "verify"):
        log("Stage G: VERIFY")
        checks = verify_deploy(job, config)
        mark_stage(job, "verify", "done", checks=checks)
        for k, v in checks.items():
            status = "OK" if v.startswith("pass") else v
            log(f"  {k}: {status}")

    # ── Stage H: Log ──
    if not stage_done(job, "log"):
        log("Stage H: LOG")
        job["completed"] = datetime.now().isoformat()
        job["wall_clock_s"] = round(time.time() - start)
        mark_stage(job, "log", "done")
        save_job(job)
        log(f"  Job record written: {jd / 'job.json'}")

    # Summary
    log(f"\n{'='*60}")
    log(f"JOB COMPLETE: {job['id']}")
    log(f"{'='*60}")
    log(f"Site:       {job['site']}")
    log(f"Topic:      {job['topic']}")
    log(f"Post ID:    {job['post_id']}")
    log(f"Author:     {job['author_id']}")
    log(f"Wall clock: {job['wall_clock_s']}s")
    for stage, data in job.get("stages", {}).items():
        extra = ""
        if "duration_s" in data:
            extra += f" ({data['duration_s']}s)"
        if "links_injected" in data:
            extra += f" ({data['links_injected']} links)"
        if "word_count" in data:
            extra += f" ({data['word_count']} words)"
        log(f"  {stage:15s} {data['status']}{extra}")
    log(f"Job dir:    {jd}")


def cmd_doctor(args):
    """Run readiness diagnostics for a site."""
    REPO_ROOT = MODULE_DIR.parent.parent
    config_path = REPO_ROOT / "sites" / args.site / "config.json"
    checks = {}

    # 1. Config loads
    if not config_path.exists():
        checks["config"] = "FAIL: config not found"
        _doctor_report(checks, args.json)
        sys.exit(1)
    with open(config_path) as f:
        config = json.load(f)

    # 2. Config validation (no TODO fields in required paths)
    missing = validate_config(config)
    checks["config_validate"] = "pass" if not missing else f"FAIL: {', '.join(missing)}"

    # 3. CSS prefix — real values
    css_pfx = config.get("content", {}).get("css_prefix", [])
    if not css_pfx or any("TODO" in str(p) for p in css_pfx):
        checks["css_prefix"] = f"FAIL: css_prefix is {css_pfx}"
    else:
        checks["css_prefix"] = "pass"

    # 4. Postprocessor
    post_tool_candidates = [
        REPO_ROOT / "tools" / f"{args.site}-postprocess.py",
        MODULE_DIR / "tools" / f"{args.site}-postprocess.py",
    ]
    if any(p.exists() for p in post_tool_candidates):
        checks["postprocessor"] = "pass"
    else:
        checks["postprocessor"] = "WARN: no postprocessor found (may not be needed)"

    # 5. Business-facts file
    facts = REPO_ROOT / "sites" / f"{args.site}-business-facts.md"
    checks["business_facts"] = "pass" if facts.exists() else "WARN: no business-facts file (H.27 handles)"

    # 6. Claims policy
    policy_path = config.get("content", {}).get("claims_policy", "")
    if policy_path:
        expanded = Path(policy_path).expanduser()
        checks["claims_policy"] = "pass" if expanded.exists() else f"FAIL: declared {policy_path} not found"
    else:
        checks["claims_policy"] = "pass (none declared)"

    # 7. Anchor pool
    pool_path_cfg = config.get("linking", {}).get("pool_path", "")
    pool_path = REPO_ROOT / pool_path_cfg if pool_path_cfg else REPO_ROOT / "sites" / f"{args.site}-anchor-pools.json"
    if pool_path.exists():
        try:
            data = json.loads(pool_path.read_text())
            checks["anchor_pool"] = f"pass ({len(data.get('destinations', data if isinstance(data, list) else []))} destinations)"
        except (json.JSONDecodeError, TypeError):
            checks["anchor_pool"] = "FAIL: anchor pool exists but is invalid JSON"
    else:
        checks["anchor_pool"] = "WARN: no anchor pool (pool-mode links will be zero)"

    # 8. Environment — NLTK + required packages
    env_issues = []
    try:
        import nltk
        nltk.data.find("taggers/averaged_perceptron_tagger_eng")
    except (ImportError, LookupError):
        env_issues.append("NLTK tagger data missing (run tools/setup-env.sh)")
    for pkg in ("bs4", "requests", "yaml"):
        try:
            __import__(pkg)
        except ImportError:
            env_issues.append(f"{pkg} not installed")
    checks["environment"] = "pass" if not env_issues else f"FAIL: {'; '.join(env_issues)}"

    # 9. Deploy — SSH connectivity
    ssh_host = config.get("access", {}).get("ssh_host", "")
    ssh_user = config.get("access", {}).get("ssh_user", "")
    ssh_key = config.get("access", {}).get("ssh_key_path", "")
    wp_path = config.get("access", {}).get("wp_path", "")
    if ssh_host and ssh_user:
        import subprocess
        key_path = Path(ssh_key).expanduser() if ssh_key else None
        ssh_cmd = ["ssh", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes",
                   "-o", "StrictHostKeyChecking=accept-new"]
        if key_path and key_path.exists():
            ssh_cmd += ["-i", str(key_path), "-o", "IdentitiesOnly=yes"]
        ssh_cmd += [f"{ssh_user}@{ssh_host}", f"test -d {wp_path} && echo ok"]
        try:
            r = subprocess.run(ssh_cmd, capture_output=True, text=True, timeout=30)
            if r.returncode == 0 and "ok" in r.stdout:
                checks["deploy_ssh"] = "pass"
            else:
                checks["deploy_ssh"] = f"FAIL: SSH returned {r.returncode}: {r.stderr[:100]}"
        except subprocess.TimeoutExpired:
            checks["deploy_ssh"] = "FAIL: SSH timed out"
        except Exception as e:
            checks["deploy_ssh"] = f"FAIL: {e}"
    else:
        checks["deploy_ssh"] = "FAIL: ssh_host or ssh_user not configured"

    _doctor_report(checks, args.json)
    has_fail = any(v.startswith("FAIL") for v in checks.values())
    sys.exit(1 if has_fail else 0)


def _doctor_report(checks: dict, as_json: bool):
    if as_json:
        print(json.dumps(checks, indent=2))
        return
    for name, result in checks.items():
        if result.startswith("FAIL"):
            icon = "\033[31mFAIL\033[0m"
        elif result.startswith("WARN"):
            icon = "\033[33mWARN\033[0m"
        else:
            icon = "\033[32m OK \033[0m"
        print(f"  [{icon}] {name}: {result}")


def cmd_queue(args):
    """Queue management subcommands."""
    from lib.queue import (
        load_queue, save_queue, add_item, list_items,
        park_item, retry_item, seed_from_gsc,
    )
    REPO_ROOT = MODULE_DIR.parent.parent

    if args.queue_action == "add":
        item = add_item(args.site, args.topic, keyword=args.keyword or args.topic,
                        intent_hint=getattr(args, "intent", ""))
        print(f"Added: {item['id']} — {item['target_keyword']}")

    elif args.queue_action == "list":
        items = list_items(args.site, status=getattr(args, "status", None))
        # Filter by origin if specified
        origin_filter = getattr(args, "origin", None)
        if origin_filter:
            items = [i for i in items if i.get("origin") == origin_filter]
        if not items:
            print("Queue is empty.")
            return
        for it in items:
            notes_count = len(it.get("backlink_notes", []))
            notes_str = f"  notes={notes_count}" if notes_count else ""
            origin_str = f"  origin={it['origin']}" if it.get("origin") else ""
            print(f"  [{it['status']:12s}] {it['id'][:12]}  {it['target_keyword'][:50]}"
                  f"  attempts={it.get('attempts', 0)}{origin_str}{notes_str}")

    elif args.queue_action == "seed":
        candidates = seed_from_gsc(
            args.site,
            min_impressions=getattr(args, "min_impressions", 50),
            limit=getattr(args, "limit", 30),
        )
        if not candidates:
            print("No candidates from GSC.")
            return
        new_candidates = [c for c in candidates if c.get("flag") == "NEW"]
        refresh_candidates = [c for c in candidates if c.get("flag") == "REFRESH"]

        if new_candidates:
            print(f"\n{len(new_candidates)} NEW candidates (no existing page owns the query):\n")
            for i, c in enumerate(new_candidates, 1):
                print(f"  {i:3d}. [{c.get('impressions', '?'):>5} imp] {c['query']}")

        if refresh_candidates:
            print(f"\n{len(refresh_candidates)} REFRESH candidates (existing page receives impressions — do NOT seed):\n")
            for i, c in enumerate(refresh_candidates, 1):
                owner = c.get("owning_page", "?")
                pos = c.get("owning_position", "?")
                print(f"  {i:3d}. [{c.get('impressions', '?'):>5} imp] {c['query']}  → {owner} (pos {pos})")

        if not new_candidates:
            print(f"\nAll {len(candidates)} candidates map to existing pages. Seed yields no new content.")
            print("Consider refreshing the listed pages instead.")
            return

        print(f"\nTo write the {len(new_candidates)} NEW candidates to queue, re-run with --confirm")
        if getattr(args, "confirm", False):
            from lib.queue import add_item
            added = 0
            for c in new_candidates:
                add_item(args.site, c["query"], keyword=c["query"])
                added += 1
            print(f"\nAdded {added} items to queue (refresh candidates excluded).")

    elif args.queue_action == "park":
        park_item(args.site, args.id)
        print(f"Parked: {args.id}")

    elif args.queue_action == "retry":
        retry_item(args.site, args.id)
        print(f"Retried (reset to pending): {args.id}")


def main():
    parser = argparse.ArgumentParser(description="RSS — Rank Logic SEO System CLI")
    sub = parser.add_subparsers(dest="command")

    # new-article
    na = sub.add_parser("new-article", help="Generate and deploy a new article as draft")
    na.add_argument("--site", required=True, help="Site ID from sites/<site>/config.json")
    na.add_argument("--topic", required=True, help="Target keyword / article topic")
    na.add_argument("--category", default="", help="Author scope category (e.g., mortgage-operational)")
    na.add_argument("--hub", default="", help="Cluster hub slug for hub box")
    na.add_argument("--source", default="serp", choices=["serp", "capture"],
                    help="Source mode: serp (SERP-driven, default) or capture (voice-capture-driven)")
    na.add_argument("--capture", default="", help="Path to capture JSON (required if --source capture)")
    na.add_argument("--skip-gap-scan", action="store_true", help="Skip competitive gap analysis")
    na.add_argument("--dry-run", action="store_true", help="Run through gates but don't deploy")
    na.add_argument("--resume", default="", help="Resume an existing job by ID")

    # doctor
    doc = sub.add_parser("doctor", help="Check site readiness for pipeline generation")
    doc.add_argument("--site", required=True, help="Site ID")
    doc.add_argument("--json", action="store_true", help="Output as JSON (for machine consumption)")

    # queue
    q = sub.add_parser("queue", help="Manage the article generation queue")
    qsub = q.add_subparsers(dest="queue_action")

    qa = qsub.add_parser("add", help="Add a topic to the queue")
    qa.add_argument("--site", required=True)
    qa.add_argument("--topic", required=True)
    qa.add_argument("--keyword", default="")
    qa.add_argument("--intent", default="")

    ql = qsub.add_parser("list", help="List queue items")
    ql.add_argument("--site", required=True)
    ql.add_argument("--status", default=None)
    ql.add_argument("--origin", default=None, help="Filter by origin (e.g., pending_link)")

    qs = qsub.add_parser("seed", help="Seed queue from GSC queries")
    qs.add_argument("--site", required=True)
    qs.add_argument("--min-impressions", type=int, default=50)
    qs.add_argument("--limit", type=int, default=30)
    qs.add_argument("--confirm", action="store_true", help="Actually write candidates to queue")

    qp = qsub.add_parser("park", help="Park a queue item")
    qp.add_argument("--site", required=True)
    qp.add_argument("--id", required=True)

    qr = qsub.add_parser("retry", help="Reset a parked item to pending")
    qr.add_argument("--site", required=True)
    qr.add_argument("--id", required=True)

    # topic-graph
    tg = sub.add_parser("topic-graph", help="Show topic graph summary (pending links, spokes, backfills)")
    tg.add_argument("--site", required=True, help="Site ID")

    args = parser.parse_args()
    if args.command == "new-article":
        cmd_new_article(args)
    elif args.command == "doctor":
        cmd_doctor(args)
    elif args.command == "topic-graph":
        from lib.topic_graph import build_topic_graph_summary
        summary = build_topic_graph_summary(args.site)
        print(f"\n=== Topic Graph: {args.site} ===\n")
        print(f"  Pending topics discovered:  {summary['pending_topics']}")
        if summary["pending_by_source"]:
            for src, count in sorted(summary["pending_by_source"].items(), key=lambda x: -x[1]):
                print(f"    {src}: {count}")
        print(f"  Resolved → linked existing: {summary['resolved_linked']}")
        print(f"  Resolved → no page:         {summary['resolved_no_page']}")
        print(f"  Queued spoke articles:       {summary['queued_spokes']}")
        print(f"  Queued backlink notes:        {summary['queued_backlink_notes']}")
        print(f"  Backfills completed:         {summary['backfills_completed']}")
        print(f"  Backfills failed:            {summary['backfills_failed']}")
    elif args.command == "queue":
        if not args.queue_action:
            q.print_help()
            sys.exit(1)
        cmd_queue(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
